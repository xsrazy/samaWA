{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/favicon.ico",
      "destination": "/assets/img/favicon.ico"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "samawa-xsrazys-projects.vercel.app"
        }
      ],
      "destination": "https://samawa.xsrazy.web.id/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "samawa-self.vercel.app"
        }
      ],
      "destination": "https://samawa.xsrazy.web.id/$1",
      "permanent": true
    }
  ]
}